{
  "name": "@headstart-health/semrush-data",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Reusable read-only Semrush capabilities and provider-result normalization",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content src vitest.config.ts",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@headstart-health/capability-contracts": "workspace:*",
    "@headstart-health/capability-runtime": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
