{
  "name": "@headstart-health/browser-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --no-cache src vitest.config.ts",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "puppeteer-core": "25.13.0",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "devtools-protocol": "0.0.1696802",
    "eslint": "^10.13.0",
    "jsdom": "26.1.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
