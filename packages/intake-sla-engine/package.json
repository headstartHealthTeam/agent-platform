{
  "name": "@headstart-health/intake-sla-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supervised Intake SLA evidence semantics and workflow orchestration",
  "bin": {
    "headstart-intake-sla": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --target node22 && tsc -p tsconfig.public.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --no-cache src vitest.config.ts",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@headstart-health/artifact-workbook": "workspace:*",
    "@headstart-health/google-read-transport": "workspace:*",
    "@headstart-health/fireflies-data": "workspace:*",
    "@headstart-health/google-sheets-data": "workspace:*",
    "@headstart-health/openai-platform": "workspace:*",
    "@headstart-health/salesforce-read": "workspace:*",
    "@headstart-health/slack-data": "workspace:*",
    "csv-parse": "7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
