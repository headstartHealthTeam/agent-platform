{
  "name": "@headstart-health/document-reading",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/office-worker.ts --format esm --dts --clean --target node22",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --no-cache src vitest.config.ts",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "clean": "rimraf dist .turbo coverage"
  },
  "bin": {
    "headstart-document": "dist/cli.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "unzipper-esm": "^0.13.2"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "jszip": "^3.10.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "@cantoo/pdf-lib": "2.7.1"
  }
}
