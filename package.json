{
  "name": "@headstart-health/agent-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:collector": "tsx scripts/run-python-tests.ts",
    "skills:install": "tsx scripts/install-skills.ts",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "qa": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm validate:skills && pnpm test:collector"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
