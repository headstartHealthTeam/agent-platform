{
  "name": "@headstart-health/agent-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --quiet --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content .",
    "check-types": "tsc --noEmit",
    "typecheck": "pnpm check-types",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "test:collector": "node --import tsx scripts/run-python-tests.ts",
    "skills:auto-update": "node --import tsx scripts/configure-auto-update.ts",
    "skills:install": "node --import tsx scripts/install-skills.ts",
    "skills:update": "node --import tsx scripts/update-skills.ts",
    "validate:skills": "node --import tsx scripts/validate-skills.ts",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:dev": "pnpm audit --audit-level moderate",
    "prepare": "husky",
    "qa:commit": "pnpm lint && pnpm check-types && pnpm test && pnpm validate:skills",
    "qa": "pnpm lint && pnpm check-types && pnpm test:coverage && pnpm validate:skills && pnpm test:collector && pnpm format:check"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
