{
  "name": "@headstart-health/agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": "9.15.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.6": "3.1.6",
      "nanoid@<3.3.18": "3.3.18"
    }
  },
  "scripts": {
    "build": "turbo run build --output-logs=errors-only",
    "clean": "turbo run clean && rimraf .turbo coverage",
    "check:secrets": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --quiet --no-cache --no-error-on-unmatched-pattern scripts skills vitest.config.ts eslint.config.mjs lint-staged.config.mjs && turbo run lint --output-logs=errors-only",
    "check-types": "tsc --noEmit && turbo run check-types --output-logs=errors-only",
    "typecheck": "npm run check-types",
    "test": "vitest run --silent && turbo run test --output-logs=errors-only",
    "test:coverage": "vitest run --coverage --silent && turbo run test:coverage --output-logs=errors-only",
    "test:collector": "node --import tsx scripts/run-python-tests.ts",
    "skills:auto-update": "node --import tsx scripts/configure-auto-update.ts",
    "skills:install": "node --import tsx scripts/install-skills.ts",
    "skills:update": "node --import tsx scripts/update-skills.ts",
    "reporting:package": "node --import tsx scripts/package-organic-runtime.ts",
    "validate:docs": "node --import tsx scripts/validate-documentation.ts",
    "validate:skills": "node --import tsx scripts/validate-skills.ts",
    "validate:workflows": "node --conditions=development --import tsx scripts/validate-workflows.ts",
    "prepare": "husky",
    "qa:commit": "npm run check:secrets && npm run lint && npm run check-types && npm test && npm run validate:skills && npm run validate:workflows && npm run validate:docs",
    "qa": "npm run check:secrets && npm run lint && npm run check-types && npm run test:coverage && npm run validate:skills && npm run validate:workflows && npm run validate:docs && npm run test:collector && npm run build && npm run format:check"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@headstart-health/workflow-runtime": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/cross-spawn": "6.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-spawn": "7.0.6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.6",
    "remark-parse": "^11.0.0",
    "rimraf": "^6.1.3",
    "secretlint": "^13.0.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  }
}
