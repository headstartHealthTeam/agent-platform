#!/usr/bin/env sh
set -eu

run_pnpm() {
  if command -v corepack >/dev/null 2>&1; then
    corepack pnpm "$@"
  else
    pnpm "$@"
  fi
}

if git diff --cached --name-only -- package.json pnpm-workspace.yaml 'apps/*/package.json' 'packages/*/package.json' 'workflows/*/package.json' | grep -q .; then
  if ! run_pnpm install --frozen-lockfile --ignore-scripts >/dev/null 2>&1; then
    printf '%s\n' 'package.json and pnpm-lock.yaml are out of sync.'
    printf '%s\n' 'Run: corepack pnpm install && git add package.json pnpm-lock.yaml'
    exit 1
  fi
fi

run_pnpm exec lint-staged --quiet
run_pnpm qa:commit
