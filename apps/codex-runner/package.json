{
  "name": "@headstart-health/codex-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Managed, contract-first Codex execution worker for Headstart agent workflows",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --no-cache src vitest.config.ts",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@headstart-health/workflow-contracts": "workspace:*",
    "@headstart-health/workflow-runtime": "workspace:*",
    "@openai/codex-sdk": "0.151.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
