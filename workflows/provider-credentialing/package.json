{
  "name": "@headstart-health/workflow-provider-credentialing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Draft credentialing workflow with payer-neutral synthetic contracts and investigative tools",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22 && tsup --config src/artifact-worker.build.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint --quiet --no-cache src vitest.config.ts",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@headstart-health/workflow-runtime": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
