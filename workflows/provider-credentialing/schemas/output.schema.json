{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2.0"
    },
    "workId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "caseRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workflowRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "routeRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["prepared-for-review", "needs-information", "blocked"]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "value": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 8000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "disposition": {
            "type": "string",
            "enum": ["supported", "unresolved", "not-applicable"]
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": ["id", "revision"],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": ["requirementId", "value", "disposition", "factIds", "evidence", "explanation"],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "description": "evidence: unresolved evidence, mapping or readback discrepancy requiring H-02; access or reconciliation: authorized access recovery or uncertain-effect reconciliation requiring blocked status and H-03. Include both stops when both conditions exist.",
            "type": "string",
            "enum": ["evidence", "access", "reconciliation"]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "nextActor": {
            "type": "string",
            "enum": ["ops", "provider", "engineering"]
          }
        },
        "required": ["id", "kind", "question", "evidenceIds", "nextActor"],
        "additionalProperties": false
      }
    },
    "humanStops": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["H-01", "H-02", "H-03", "H-04", "H-05"]
      }
    },
    "handoff": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  },
  "required": [
    "schemaVersion",
    "workId",
    "caseRevision",
    "workflowRevision",
    "routeRevision",
    "status",
    "answers",
    "questions",
    "humanStops",
    "handoff"
  ],
  "additionalProperties": false
}
