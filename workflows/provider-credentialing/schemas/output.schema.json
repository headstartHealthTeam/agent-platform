{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.2.0"
        },
        "workId": {
          "$ref": "#/$defs/__schema0"
        },
        "caseRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "workflowRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "routeRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "$ref": "#/$defs/__schema1"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "$ref": "#/$defs/__schema0"
              },
              "value": {
                "$ref": "#/$defs/__schema2"
              },
              "disposition": {
                "$ref": "#/$defs/__schema3"
              },
              "factIds": {
                "$ref": "#/$defs/__schema4"
              },
              "evidence": {
                "$ref": "#/$defs/__schema5"
              },
              "explanation": {
                "$ref": "#/$defs/__schema6"
              }
            },
            "required": [
              "requirementId",
              "value",
              "disposition",
              "factIds",
              "evidence",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "kind": {
                "$ref": "#/$defs/__schema7"
              },
              "question": {
                "$ref": "#/$defs/__schema6"
              },
              "evidenceIds": {
                "$ref": "#/$defs/__schema8"
              },
              "nextActor": {
                "$ref": "#/$defs/__schema9"
              }
            },
            "required": ["id", "kind", "question", "evidenceIds", "nextActor"],
            "additionalProperties": false
          }
        },
        "humanStops": {
          "$ref": "#/$defs/__schema10"
        },
        "handoff": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "schemaVersion",
        "workId",
        "caseRevision",
        "workflowRevision",
        "routeRevision",
        "status",
        "answers",
        "questions",
        "humanStops",
        "handoff"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.3.0"
        },
        "workId": {
          "$ref": "#/$defs/__schema0"
        },
        "caseRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "workflowRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "routeRevision": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "$ref": "#/$defs/__schema1"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "$ref": "#/$defs/__schema0"
              },
              "value": {
                "$ref": "#/$defs/__schema2"
              },
              "disposition": {
                "$ref": "#/$defs/__schema3"
              },
              "factIds": {
                "$ref": "#/$defs/__schema4"
              },
              "evidence": {
                "$ref": "#/$defs/__schema5"
              },
              "explanation": {
                "$ref": "#/$defs/__schema6"
              },
              "basis": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "documented",
                      "declared",
                      "verified",
                      "operator-selected",
                      "proxy",
                      "inferred"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "requirementId",
              "value",
              "disposition",
              "factIds",
              "evidence",
              "explanation",
              "basis"
            ],
            "additionalProperties": false
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "kind": {
                "$ref": "#/$defs/__schema7"
              },
              "question": {
                "$ref": "#/$defs/__schema6"
              },
              "evidenceIds": {
                "$ref": "#/$defs/__schema8"
              },
              "nextActor": {
                "$ref": "#/$defs/__schema9"
              },
              "review": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "knownContext": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "$ref": "#/$defs/__schema11"
                        },
                        "evidence": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema12"
                          }
                        }
                      },
                      "required": ["text", "evidence"],
                      "additionalProperties": false
                    }
                  },
                  "requestedItems": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema11"
                    }
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": ["answer", "attachment", "protected-action"]
                        },
                        "id": {
                          "$ref": "#/$defs/__schema13"
                        }
                      },
                      "required": ["kind", "id"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["title", "knownContext", "requestedItems", "requirements"],
                "additionalProperties": false
              }
            },
            "required": ["id", "kind", "question", "evidenceIds", "nextActor"],
            "additionalProperties": false
          }
        },
        "humanStops": {
          "$ref": "#/$defs/__schema10"
        },
        "handoff": {
          "$ref": "#/$defs/__schema6"
        },
        "deliverables": {
          "description": "Generated review aids, retained separately from source evidence and payer attachments. Exact files must be queued and retained before publication. Their existence does not establish readiness or verification.",
          "$ref": "#/$defs/__schema14"
        },
        "opsReview": {
          "type": "object",
          "properties": {
            "summary": {
              "$ref": "#/$defs/__schema11"
            },
            "findings": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema19"
              }
            },
            "nextStep": {
              "$ref": "#/$defs/__schema11"
            },
            "investigation": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "$ref": "#/$defs/__schema12"
                  },
                  "discoveredFrom": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/__schema12"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "outcome": {
                    "type": "string",
                    "enum": ["inspected", "unavailable", "not-relevant"]
                  },
                  "detail": {
                    "$ref": "#/$defs/__schema11"
                  }
                },
                "required": ["source", "discoveredFrom", "outcome", "detail"],
                "additionalProperties": false
              }
            }
          },
          "required": ["summary", "findings", "nextStep", "investigation"],
          "additionalProperties": false
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "$ref": "#/$defs/__schema16"
              },
              "disposition": {
                "type": "string",
                "enum": ["proposed", "unresolved", "not-applicable"]
              },
              "artifact": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema18"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "explanation": {
                "$ref": "#/$defs/__schema20"
              }
            },
            "required": ["requirementId", "disposition", "artifact", "explanation"],
            "additionalProperties": false
          }
        },
        "protectedActions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "$ref": "#/$defs/__schema16"
              },
              "disposition": {
                "type": "string",
                "enum": ["human-required", "unresolved"]
              },
              "explanation": {
                "$ref": "#/$defs/__schema20"
              }
            },
            "required": ["requirementId", "disposition", "explanation"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "workId",
        "caseRevision",
        "workflowRevision",
        "routeRevision",
        "status",
        "answers",
        "questions",
        "humanStops",
        "handoff",
        "attachments",
        "protectedActions"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema1": {
      "type": "string",
      "enum": ["prepared-for-review", "needs-information", "blocked"]
    },
    "__schema2": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8000
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema3": {
      "type": "string",
      "enum": ["supported", "unresolved", "not-applicable"]
    },
    "__schema4": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema5": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "revision": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": ["id", "revision"],
        "additionalProperties": false
      }
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "__schema7": {
      "type": "string",
      "enum": ["evidence", "access", "reconciliation"],
      "description": "evidence: unresolved evidence, mapping or readback discrepancy requiring H-02; access or reconciliation: authorized access recovery or uncertain-effect reconciliation requiring blocked status and H-03. Include both stops when both conditions exist."
    },
    "__schema8": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema9": {
      "type": "string",
      "enum": ["ops", "provider", "engineering"]
    },
    "__schema10": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["H-01", "H-02", "H-03", "H-04", "H-05"]
      }
    },
    "__schema11": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema13"
        },
        "revision": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": ["id", "revision"],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema14": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema15"
      }
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema16"
        },
        "revision": {
          "$ref": "#/$defs/__schema16"
        },
        "digest": {
          "$ref": "#/$defs/__schema17"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!\\.{1,2}$)(?!\\s)(?![\\s\\S]*\\s$)[^\\\\/\\p{Cc}]+$"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema16"
        },
        "purpose": {
          "type": "string",
          "enum": ["review-checklist", "preparation-package", "supporting-report"]
        },
        "sources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema18"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "digest",
        "title",
        "filename",
        "mediaType",
        "purpose",
        "sources"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema17": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema16"
        },
        "revision": {
          "$ref": "#/$defs/__schema16"
        },
        "digest": {
          "$ref": "#/$defs/__schema17"
        }
      },
      "required": ["id", "revision", "digest"],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/__schema11"
        },
        "evidence": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema12"
          }
        }
      },
      "required": ["text", "evidence"],
      "additionalProperties": false
    },
    "__schema20": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  }
}
