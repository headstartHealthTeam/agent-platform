    "__schema4": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8000
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema5": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
