          "revision": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": ["id", "revision"],
        "additionalProperties": false
      }
    },
    "__schema6": {
      "type": "string",
      "enum": ["available", "awaiting-file", "missing", "error"]
    },
    "__schema7": {
      "type": "string",
      "enum": ["current", "expired", "unknown"]
    },
    "__schema8": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "question": {
          "$ref": "#/$defs/__schema9"
        },
        "required": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": ["id", "question", "required"],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "boolean"
    },
    "__schema12": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["prepared", "populated", "submitted", "approved", "active", "billing-verified"]
      }
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "priorOutcome": {
          "type": "string",
          "enum": ["none", "confirmed", "unknown"]
        },
        "stopRequested": {
          "type": "boolean"
        },
        "permittedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["inspect", "prepare"]
          }
        }
      },
      "required": ["priorOutcome", "stopRequested", "permittedActions"],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "question": {
          "$ref": "#/$defs/__schema9"
        },
        "required": {
          "$ref": "#/$defs/__schema11"
        },
        "scope": {
          "$ref": "#/$defs/__schema17"
        },
        "destination": {
          "$ref": "#/$defs/__schema18"
