          "$ref": "#/$defs/__schema14"
        },
        "locationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema14"
          }
        },
        "recordId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema14"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["subjectId", "locationIds", "recordId"],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/__schema14"
        },
        "section": {
          "$ref": "#/$defs/__schema14"
        },
        "field": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": ["system", "section", "field"],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "string",
      "enum": ["owner", "managing-employee", "employer", "institution", "authorized-representative"]
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema14"
        },
        "revision": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": ["id", "revision"],
      "additionalProperties": false
    },
    "__schema21": {
      "type": "string",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "__schema22": {
      "type": "string",
      "enum": ["service", "pay-to", "mail-to"]
    },
    "__schema23": {
      "pattern": "\\S",
      "$ref": "#/$defs/__schema14",
      "type": "string"
    },
    "__schema24": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema14"
        },
        "revision": {
          "$ref": "#/$defs/__schema14"
        },
        "digest": {
          "$ref": "#/$defs/__schema24"
        }
      },
      "required": ["id", "revision", "digest"],
      "additionalProperties": false
    }
  }
}
