              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema20"
                }
              },
              "lineage": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "source"
