    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.2.0"
        },
        "dataMode": {
          "$ref": "#/$defs/__schema0"
        },
        "caseRevision": {
          "$ref": "#/$defs/__schema1"
        },
        "workflowRevision": {
          "$ref": "#/$defs/__schema1"
        },
        "routeRevision": {
