                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "converted"
                      },
                      "sources": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/__schema25"
