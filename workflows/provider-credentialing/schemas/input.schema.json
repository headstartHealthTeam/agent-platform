      "required": [
        "schemaVersion",
        "dataMode",
        "caseRevision",
        "workflowRevision",
        "routeRevision",
        "work",
        "facts",
        "evidence",
        "requirements",
        "recordedMilestones",
        "execution",
        "relatedParties",
        "records",
        "artifacts",
        "attachmentRequirements",
        "protectedActionRequirements"
