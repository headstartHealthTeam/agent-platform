{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.3.0"
    },
    "dataMode": {
      "type": "string",
      "const": "production-read"
    },
    "caseRevision": {
      "$ref": "#/$defs/__schema0"
    },
    "workflowRevision": {
      "$ref": "#/$defs/__schema0"
    },
    "routeRevision": {
      "$ref": "#/$defs/__schema0"
    },
    "work": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "providerId": {
          "$ref": "#/$defs/__schema0"
        },
        "practiceId": {
          "$ref": "#/$defs/__schema0"
        },
        "payer": {
          "$ref": "#/$defs/__schema0"
        },
        "product": {
          "$ref": "#/$defs/__schema0"
        },
        "jurisdiction": {
          "$ref": "#/$defs/__schema0"
        },
        "requestType": {
          "type": "string",
          "enum": ["initial-enrollment", "group-add", "renewal", "maintenance"]
        },
        "locationIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "period": {
          "$ref": "#/$defs/__schema0"
        },
        "existingAffiliationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "providerId",
        "practiceId",
        "payer",
        "product",
        "jurisdiction",
        "requestType",
        "locationIds",
        "period",
        "existingAffiliationIds"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "key": {
            "$ref": "#/$defs/__schema0"
          },
          "subjectId": {
            "$ref": "#/$defs/__schema0"
          },
          "locationIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "value": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 8000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "documented",
              "declared",
              "verified",
              "operator-selected",
              "proxy",
              "unknown",
              "conflicting",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/__schema0"
                },
                "revision": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": ["id", "revision"],
              "additionalProperties": false
            }
          },
          "recordId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          },
          "qualification": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema2"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "key",
          "subjectId",
          "locationIds",
          "value",
          "disposition",
          "evidence",
          "recordId",
          "qualification"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "revision": {
            "$ref": "#/$defs/__schema0"
          },
          "subjectId": {
            "$ref": "#/$defs/__schema0"
          },
          "title": {
            "$ref": "#/$defs/__schema0"
          },
          "retrieval": {
            "type": "string",
            "enum": ["available", "awaiting-file", "missing", "error"]
          },
          "validity": {
            "type": "string",
            "enum": ["current", "expired", "unknown"]
          },
          "content": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "type": "null"
              }
            ]
          },
          "locationIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "recordId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ],
            "description": "Internal records[].id or null for subject-wide evidence; never the external source record ID."
          },
          "observedAt": {
            "type": "string",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "system": {
                "$ref": "#/$defs/__schema1"
              },
              "recordId": {
                "$ref": "#/$defs/__schema1"
              },
              "version": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": ["system", "recordId", "version"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "revision",
          "subjectId",
          "title",
          "retrieval",
          "validity",
          "content",
          "locationIds",
          "recordId",
          "observedAt",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "recordedMilestones": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["prepared", "populated", "submitted", "approved", "active", "billing-verified"]
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "priorOutcome": {
          "type": "string",
          "enum": ["none", "confirmed", "unknown"]
        },
        "stopRequested": {
          "type": "boolean"
        },
        "permittedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["inspect", "prepare"]
          }
        }
      },
      "required": ["priorOutcome", "stopRequested", "permittedActions"],
      "additionalProperties": false
    },
    "relatedParties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "kind": {
            "type": "string",
            "enum": ["person", "organization"]
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema7"
            }
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema8"
            }
          }
        },
        "required": ["id", "kind", "roles", "evidence"],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "kind": {
            "type": "string",
            "enum": [
              "address",
              "education",
              "employment",
              "ownership",
              "management",
              "license",
              "coverage"
            ]
          },
          "subjectId": {
            "$ref": "#/$defs/__schema1"
          },
          "relatedPartyId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          },
          "locationIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "period": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/__schema9"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/__schema9"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["start", "end"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "addressRole": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema10"
              },
              {
                "type": "null"
              }
            ],
            "description": "Established payer role only. Null when the source address has no established payer mapping; preserve sourceAddressType and any unresolved mapping in the handoff."
          },
          "sourceAddressType": {
            "description": "Source context such as business or registered-agent, not payer eligibility. Required for an address whose payer role is unknown. Omit for non-address records.",
            "$ref": "#/$defs/__schema11"
          }
        },
        "required": [
          "id",
          "kind",
          "subjectId",
          "relatedPartyId",
          "locationIds",
          "period",
          "addressRole"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "revision": {
            "$ref": "#/$defs/__schema1"
          },
          "digest": {
            "$ref": "#/$defs/__schema12"
          },
          "mediaType": {
            "$ref": "#/$defs/__schema1"
          },
          "scope": {
            "$ref": "#/$defs/__schema5"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "lineage": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "source"
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "converted"
                  },
                  "sources": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/__schema13"
                    }
                  },
                  "transformation": {
                    "$ref": "#/$defs/__schema8"
                  }
                },
                "required": ["kind", "sources", "transformation"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["id", "revision", "digest", "mediaType", "scope", "evidence", "lineage"],
        "additionalProperties": false
      }
    },
    "attachmentRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "question": {
            "$ref": "#/$defs/__schema2"
          },
          "required": {
            "type": "boolean"
          },
          "scope": {
            "$ref": "#/$defs/__schema5"
          },
          "destination": {
            "$ref": "#/$defs/__schema6"
          },
          "acceptedMediaTypes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": ["id", "question", "required", "scope", "destination", "acceptedMediaTypes"],
        "additionalProperties": false
      }
    },
    "protectedActionRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "action": {
            "type": "string",
            "enum": ["signature", "attestation", "declaration", "submission"]
          },
          "actorSubjectId": {
            "$ref": "#/$defs/__schema1"
          },
          "actorRole": {
            "$ref": "#/$defs/__schema1"
          },
          "destination": {
            "$ref": "#/$defs/__schema6"
          },
          "attachmentRequirementIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "blocksRequirementIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": [
          "id",
          "action",
          "actorSubjectId",
          "actorRole",
          "destination",
          "attachmentRequirementIds",
          "blocksRequirementIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "dataMode",
    "caseRevision",
    "workflowRevision",
    "routeRevision",
    "work",
    "facts",
    "evidence",
    "requirements",
    "recordedMilestones",
    "execution",
    "relatedParties",
    "records",
    "artifacts",
    "attachmentRequirements",
    "protectedActionRequirements"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "question": {
          "$ref": "#/$defs/__schema3"
        },
        "required": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/__schema5"
        },
        "destination": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": ["id", "question", "required", "scope", "destination"],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "subjectId": {
          "$ref": "#/$defs/__schema1"
        },
        "locationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "recordId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["subjectId", "locationIds", "recordId"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/__schema1"
        },
        "section": {
          "$ref": "#/$defs/__schema1"
        },
        "field": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["system", "section", "field"],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "enum": ["owner", "managing-employee", "employer", "institution", "authorized-representative"]
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["id", "revision"],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "__schema10": {
      "type": "string",
      "enum": ["service", "pay-to", "mail-to"]
    },
    "__schema11": {
      "pattern": "\\S",
      "$ref": "#/$defs/__schema1",
      "type": "string"
    },
    "__schema12": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "digest": {
          "$ref": "#/$defs/__schema12"
        }
      },
      "required": ["id", "revision", "digest"],
      "additionalProperties": false
    }
  }
}
